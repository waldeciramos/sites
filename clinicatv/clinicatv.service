[Unit]
Description=Clinica TV (servidor interno)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clinicatv
Group=clinicatv
WorkingDirectory=/opt/clinicatv
EnvironmentFile=-/etc/clinicatv.env
ExecStart=/usr/bin/node /opt/clinicatv/server.js
Restart=always
RestartSec=3
# permite usar a porta 80 sem rodar como root
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/clinicatv/dados /opt/clinicatv/midia
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
